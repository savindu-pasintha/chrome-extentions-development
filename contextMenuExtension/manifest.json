{
  "manifest_version": 3,
  "name": "Ask any thing",
  "version": "1.0",
  "description": "Adds a new item to the context menu.",
  "permissions": ["contextMenus", "activeTab", "scripting", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Chat"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
